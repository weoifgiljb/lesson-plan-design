{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/session-start.py\"",
            "statusMessage": "加载校标教案闸门",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/hook-post-write.py\"",
            "statusMessage": "写回后校验教案 JSON",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/hook-stop.py\"",
            "statusMessage": "校标结构质量门",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
