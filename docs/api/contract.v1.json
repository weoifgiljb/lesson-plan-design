  "errorCodes": [
    {
      "code": "AUTH_REQUIRED",
      "http": 401,
      "zh": "未登录或登录已失效",
      "scene": "缺少/过期的会话 Cookie 或 Bearer 令牌、用户名口令错误"
    },
    {
      "code": "FORBIDDEN",
      "http": 403,
      "zh": "无权限执行该操作",
      "scene": "角色不允许、归属校验失败、CSRF 校验失败、自助注册已关闭"
    },
    {
      "code": "USERNAME_TAKEN",
      "http": 409,
      "zh": "用户名已被占用",
      "scene": "注册或建号时用户名重复"
    },
    {
      "code": "REGISTRATION_CLOSED",
      "http": 403,
      "zh": "平台已关闭自助注册",
      "scene": "LPP_ALLOW_REGISTRATION=0 时的自助注册请求"
    },
    {
      "code": "PASSWORD_CHANGE_REQUIRED",
      "http": 403,
      "zh": "请先修改初始口令",
      "scene": "账号 must_change_password=1 时访问改密以外的业务接口"
    },
    {
      "code": "NOT_FOUND",
      "http": 404,
      "zh": "资源不存在",
      "scene": "id 无效或对象已软删除"
    },
    {
      "code": "METHOD_NOT_ALLOWED",
      "http": 405,
      "zh": "请求方法不被允许",
      "scene": "对已存在的路径使用了未登记的 HTTP 方法（如 PUT /settings/engine）"
    },
    {
      "code": "CONFLICT_STALE",
      "http": 409,
      "zh": "数据已变化，请刷新后重试",
      "scene": "乐观锁/唯一键冲突（重复导入、重复建课、用户名已存在）"
    },
    {
      "code": "CONFLICT_DELETED",
      "http": 409,
      "zh": "对象已删除",
      "scene": "带 planId 推送时目标教案已软删除"
    },
    {
      "code": "HASH_MISMATCH",
      "http": 422,
      "zh": "哈希校验不一致",
      "scene": "契约包/样例/产物的 planHash 或 sha256 与登记值不符"
    },
    {
      "code": "SCHEMA_UNSUPPORTED",
      "http": 422,
      "zh": "不支持的结构版本",
      "scene": "schemaVersion / rubricVersion 超出支持范围"
    },
    {
      "code": "STRUCTURE_INVALID",
      "http": 422,
      "zh": "结构校验未通过",
      "scene": "教案字段缺失或类型错误"
    },
    {
      "code": "REPORT_INCONSISTENT",
      "http": 422,
      "zh": "审查报告与教案不一致",
      "scene": "轮次跳号、报告哈希与版本不匹配、证据链断裂"
    },
    {
      "code": "MEDIA_MISSING",
      "http": 422,
      "zh": "引用的媒体文件缺失",
      "scene": "教案声明的截图/附件未随包上传或本地已丢失"
    },
    {
      "code": "PAYLOAD_REJECTED",
      "http": 422,
      "zh": "请求内容不符合要求",
      "scene": "字段校验失败、口令强度不足、路径越界"
    },
    {
      "code": "UNSUPPORTED_MEDIA",
      "http": 415,
      "zh": "不支持的上传类型",
      "scene": "上传文件不是 zip/json 等允许的类型"
    },
    {
      "code": "PAYLOAD_TOO_LARGE",
      "http": 413,
      "zh": "上传内容超过大小上限",
      "scene": "契约包 50MB、样例 2MB 等限制"
    },
    {
      "code": "RATE_LIMITED",
      "http": 429,
      "zh": "请求过于频繁",
      "scene": "登录连续失败锁定、后续可扩展的限流策略"
    },
    {
      "code": "SERVICE_UNAVAILABLE",
      "http": 503,
      "zh": "服务暂不可用",
      "scene": "数据库结构未对齐（旧库需先运行 repair_schema.py）或磁盘不可写"
    },
    {
      "code": "INTERNAL",
      "http": 500,
      "zh": "服务器内部错误",
      "scene": "未归类的异常（响应体不含堆栈与服务器路径）"
    }
  ],
