  "errorCodes": [
    {
      "code": "AUTH_REQUIRED",
      "http": 401,
      "zh": "未登录",
      "scene": "无会话访问业务接口"
    },
    {
      "code": "FORBIDDEN",
      "http": 403,
      "zh": "无权限",
      "scene": "越权访问他人资源或管理员接口"
    },
    {
      "code": "NOT_FOUND",
      "http": 404,
      "zh": "不存在",
      "scene": "id 无效或已软删除"
    },
    {
      "code": "CONFLICT_STALE",
      "http": 409,
      "zh": "版本冲突",
      "scene": "baseHash 与服务端头版本不一致"
    },
    {
      "code": "HASH_MISMATCH",
      "http": 422,
      "zh": "哈希不符",
      "scene": "教案内容被篡改或传输损坏"
    },
    {
      "code": "SCHEMA_UNSUPPORTED",
      "http": 422,
      "zh": "版本不支持",
      "scene": "未知 schemaVersion 或 rubricVersion"
    },
    {
      "code": "STRUCTURE_INVALID",
      "http": 422,
      "zh": "结构校验失败",
      "scene": "复校未通过，附 issue 列表"
    },
    {
      "code": "REPORT_INCONSISTENT",
      "http": 422,
      "zh": "报告不一致",
      "scene": "报告哈希、轮次、状态、放行与教案不符"
    },
    {
      "code": "MEDIA_MISSING",
      "http": 422,
      "zh": "媒体缺失",
      "scene": "媒体文件缺失或哈希不符"
    },
    {
      "code": "PAYLOAD_REJECTED",
      "http": 422,
      "zh": "包内容被拒",
      "scene": "zip 条目含 ..、绝对路径、符号链接或非白名单文件"
    },
    {
      "code": "PAYLOAD_TOO_LARGE",
      "http": 413,
      "zh": "请求过大",
      "scene": "单包超过 50 MB"
    },
    {
      "code": "UNSUPPORTED_MEDIA",
      "http": 415,
      "zh": "媒体类型不支持",
      "scene": "上传契约包不是 zip 或内容类型不符"
    },
    {
      "code": "RATE_LIMITED",
      "http": 429,
      "zh": "触发限流",
      "scene": "登录或导入过于频繁"
    },
    {
      "code": "INTERNAL",
      "http": 500,
      "zh": "服务端错误",
      "scene": "未预期异常，附 traceId"
    }
  ],
